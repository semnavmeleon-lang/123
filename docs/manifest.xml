<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
    xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
    xsi:type="MailApp">

  <Id>d31065da-3352-45b9-8746-38424061c662</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Save Email Add-in</ProviderName>
  <DefaultLocale>ru-RU</DefaultLocale>
  <DisplayName DefaultValue="Сохранить письмо" />
  <Description DefaultValue="Сохраняет открытое письмо (вместе с вложениями) на компьютер в виде файла .eml" />
  <IconUrl DefaultValue="https://semnavmeleon-lang.github.io/123/assets/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://semnavmeleon-lang.github.io/123/assets/icon-80.png" />
  <SupportUrl DefaultValue="https://github.com/semnavmeleon-lang/123" />

  <AppDomains>
    <AppDomain>https://semnavmeleon-lang.github.io/123</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.8" />
    </Sets>
  </Requirements>

  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://semnavmeleon-lang.github.io/123/taskpane.html" />
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadWriteItem</Permissions>

  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read" />
  </Rule>

  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.8">
        <bt:Set Name="Mailbox" />
      </bt:Sets>
    </Requirements>

    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <FunctionFile resid="Commands.Url" />

          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="SaveEmailGroup">
                <Label resid="GroupLabel" />
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16" />
                  <bt:Image size="32" resid="Icon.32x32" />
                  <bt:Image size="80" resid="Icon.80x80" />
                </Icon>
                <Control xsi:type="Button" id="SaveEmailButton">
                  <Label resid="SaveButton.Label" />
                  <Supertip>
                    <Title resid="SaveButton.Label" />
                    <Description resid="SaveButton.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://semnavmeleon-lang.github.io/123/assets/icon-16.png" />
        <bt:Image id="Icon.32x32" DefaultValue="https://semnavmeleon-lang.github.io/123/assets/icon-32.png" />
        <bt:Image id="Icon.80x80" DefaultValue="https://semnavmeleon-lang.github.io/123/assets/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://semnavmeleon-lang.github.io/123/taskpane.html" />
        <bt:Url id="Taskpane.Url" DefaultValue="https://semnavmeleon-lang.github.io/123/taskpane.html" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GroupLabel" DefaultValue="Сохранение писем" />
        <bt:String id="SaveButton.Label" DefaultValue="Сохранить письмо" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="SaveButton.Tooltip" DefaultValue="Скачать это письмо вместе с вложениями на компьютер (.eml)" />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
